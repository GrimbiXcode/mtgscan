{
  "name": "mtgscan",
  "version": "1.0.0",
  "description": "Web app to scan Magic: The Gathering cards using device camera and export to Moxfield",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "python3 -m http.server 8080",
    "benchmark": "NODE_USE_ENV_PROXY=1 node sandbox/benchmark.js"
  },
  "keywords": [
    "mtg",
    "magic-the-gathering",
    "card-scanner",
    "scryfall",
    "moxfield"
  ],
  "author": "David Grimbichler (grimbixcode)",
  "license": "GNU GPLv3",
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "canvas": "^3.2.0",
    "fuzzyset": "^1.0.7",
    "levenshtein-distance": "^0.0.2",
    "sharp": "^0.34.3",
    "vite": "^7.1.11"
  },
  "dependencies": {
    "tesseract.js": "^6.0.0"
  }
}
